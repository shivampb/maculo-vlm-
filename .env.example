# Copy this file to .env and change what you need. Every setting is optional.

# Where the server listens. Use 0.0.0.0 to allow other devices on your network.
MACULO_HOST=127.0.0.1
MACULO_PORT=8000

# auto picks the GPU when one is available. Or set cpu / cuda.
MACULO_DEVICE=auto

# Model locations
MACULO_SAM_DIR=models/sam
MACULO_CLIP_ID=hf-hub:Xieji-Li/MAGEN-O-MAKE

# Limits
MACULO_MAX_UPLOAD_MB=15
MACULO_MAX_IMAGE_SIDE=1024
MACULO_MAX_LABELS=120
MACULO_UPLOADS_PER_MINUTE=30
MACULO_SESSION_TTL_S=900
MACULO_SESSION_CAPACITY=32

# Set to false to hide the interactive API docs at /docs
MACULO_ENABLE_DOCS=true

# Only when running behind a reverse proxy (nginx, Caddy, a cloud load balancer)
MACULO_TRUST_PROXY=false
# Comma-separated origins allowed to call the API from other websites
MACULO_CORS_ORIGINS=

MACULO_LOG_LEVEL=info
